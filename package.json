{
  "name": "vs-audio",
  "displayName": "Audio Transcription",
  "description": "Transcribe audio files using Lemonade server with Whisper",
  "version": "1.1.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:lemonadeStatus"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "audio-activity-bar",
          "title": "Audio",
          "icon": "$(mic)"
        }
      ]
    },
    "commands": [
      {
        "command": "audio.transcribeAudio",
        "title": "Transcribe Audio File"
      },
      {
        "command": "audio.showLemonadeStatus",
        "title": "Show Lemonade Server Status"
      },
      {
        "command": "audio.refreshLemonadeStatus",
        "title": "Refresh Lemonade Status"
      },
      {
        "command": "audio.editServerUrl",
        "title": "Edit Server URL"
      },
      {
        "command": "audio.loadWhisperModel",
        "title": "Load Whisper Model"
      },
      {
        "command": "audio.unloadWhisperModel",
        "title": "Unload Whisper Model"
      },
      {
        "command": "audio.pickTranscriptionModel",
        "title": "Select for Transcription"
      }
    ],
    "configuration": {
      "title": "Audio Transcription",
      "properties": {
        "audio.lemonadeServerUrl": {
          "type": "string",
          "default": "http://localhost:13305",
          "description": "URL of your Lemonade server with Whisper"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsce-package": "vsce package",
    "ovsx": "ovsx package",
    "efix": "eslint src --fix"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.8.0",
    "ovsx": "^1.0.2",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "keywords": [
    "audio",
    "transcription",
    "whisper",
    "lemonade"
  ]
}