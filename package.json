{
  "name": "audio-lab",
  "displayName": "Audio Lab",
  "description": "Transcribe audio files using Lemonade server with Whisper",
  "publisher": "lanly-dev",
  "version": "0.0.1",
  "sponsor": {
    "url": "https://github.com/sponsors/lanly-dev"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
    "keywords": [
    "audio",
    "lemonade",
    "transcription",
    "whisper"
  ],
  "icon": "media/audio-lab.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "audio-lab-activity-bar",
          "title": "AudioLab",
          "icon": "media/audio-lab-icon.svg"
        }
      ]
    },
    "views": {
      "audio-lab-activity-bar": [
        {
          "id": "lemonadeStatus",
          "name": "Lemonade Server Status",
          "icon": "$(server)"
        }
      ]
    },
    "commands": [
      {
        "command": "audio-lab.changeServerUrl",
        "title": "AudioLab: Change Lemonade Server URL",
        "icon": "$(edit)"
      },
      {
        "command": "audio-lab.openAudioFile",
        "title": "AudioLab: Open Audio File in Editor"
      },
      {
        "command": "audio-lab.pickModel",
        "title": "Pick This Model"
      },
      {
        "command": "audio-lab.refreshServerStatus",
        "title": "AudioLab: Refresh Lemonade Server Status",
        "icon": "$(refresh)"
      },
      {
        "command": "audio-lab.revealInExplorer",
        "title": "AudioLab: Reveal in Explorer"
      },
      {
        "command": "audio-lab.transcribeAudioFile",
        "title": "AudioLab: Transcribe Audio From File Chooser"
      },
      {
        "command": "audio-lab.transcribeAudioItem",
        "title": "AudioLab: Transcribe Audio"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "audio-lab.pickModel",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "audio-lab.changeServerUrl",
          "when": "view == lemonadeStatus && viewItem == LEMONADE_SERVER_URL",
          "group": "inline"
        },
        {
          "command": "audio-lab.pickModel",
          "when": "view == lemonadeStatus && viewItem == WHISPER_AVAILABLE",
          "group": "inline"
        },
        {
          "command": "audio-lab.revealInExplorer",
          "when": "view == lemonadeStatus && (viewItem == AUDIO_ITEM || viewItem == AUDIO_DIRECTORY)",
          "group": "1_modification"
        },
        {
          "command": "audio-lab.transcribeAudioItem",
          "when": "view == lemonadeStatus && viewItem == AUDIO_ITEM",
          "group": "1_modification"
        }
      ],
      "view/title": [
        {
          "command": "audio-lab.refreshServerStatus",
          "when": "view == lemonadeStatus",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Audio Lab",
      "properties": {
        "audio-lab.pickedModel": {
          "type": "string",
          "default": null,
          "description": "Currently picked model for transcription"
        },
        "audio-lab.lemonadeServerUrl": {
          "type": "string",
          "default": "http://localhost:13305",
          "description": "Lemonade Server URL"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsce-package": "vsce package",
    "ovsx": "ovsx package",
    "efix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "ovsx": "^1.0.2",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
    "repository": {
    "type": "git",
    "url": "git+https://github.com/lanly-dev/vscode-audio-lab.git"
  },
  "bugs": {
    "url": "https://github.com/lanly-dev/vscode-audio-lab/issues"
  },
  "license": "MIT"
}
