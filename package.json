{
  "name": "vs-audio",
  "displayName": "Audio",
  "description": "Using whisper",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsaudio.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsce-package": "vsce package",
    "ovsx": "ovsx package",
    "efix": "eslint src --fix"
  },
  "devDependencies": {
    "@types/node": "26.x",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.8.0",
    "ovsx": "^1.0.2",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
